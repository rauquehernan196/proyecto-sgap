        <mxCell id="note" value="SQLite: db.sqlite3&lt;br&gt;Las tablas de autenticación y sesiones propias de Django no se muestran.&lt;br&gt;FK requester y procedure usan protección contra borrado; resolved_by y actor aceptan NULL." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
